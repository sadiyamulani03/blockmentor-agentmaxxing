# 1. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use
GEMINI_MODEL=gemini-flash-latest

# 3. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=

# 4. x402 payment config (Base Sepolia test-USDC, premium pack unlock)
#    Receiving Base Sepolia address for pack payments (required to enable payments).
X402_PAY_TO=
#    (Optional) Facilitator URL. Defaults to the official public testnet facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator
#    (Optional) Price for the Advanced Solidity Security Pack unlock.
X402_PRICE=$0.10
